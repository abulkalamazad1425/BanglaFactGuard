# BanglaFactGuard backend configuration template.
# Copy to `.env` and fill in your own values. Never commit real secrets.
# Every variable maps to a field in app/core/config.py (prefix = settings group).

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json
# JSON list. Clients send `Authorization: Bearer`, not cookies.
CORS_ORIGINS=["*"]

# ── Auth (required) ─────────────────────────────────────────────────────────
# JWT signing key, at least 32 characters. The app refuses to start without it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=

# ── PostgreSQL ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bangla_fact_guard
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO_SQL=false

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL_CLAIM_RESULT=86400
REDIS_TTL_NOT_FOUND_RESULT=3600
REDIS_TTL_SEARCH_RESULT=21600

# ── Search ──────────────────────────────────────────────────────────────────
SEARCH_TOP_K_CANDIDATES=15

# ── Local ML models ─────────────────────────────────────────────────────────
ML_EMBEDDING_MODEL_NAME=sentence-transformers/LaBSE
ML_NLI_MODEL_NAME=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
ML_NER_MODEL_NAME=arafatfahim/BanglaTag
ML_EMBEDDING_BATCH_SIZE=32
ML_LOAD_MODELS_ON_STARTUP=true

# ── Gemini (photo-card reading) ─────────────────────────────────────────────
# Extra keys for rotation: GEMINI_API_KEY1, GEMINI_API_KEY2, ...
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_ATTEMPTS_PER_BATCH=3
GEMINI_BATCHES=3
GEMINI_BATCH_PAUSE_SECONDS=10
GEMINI_RETRY_BASE_DELAY_SECONDS=1.0

# ── Photo-card uploads ──────────────────────────────────────────────────────
PHOTOCARD_MAX_IMAGE_BYTES=10485760

# ── MinIO (image storage) ───────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=bangla-fact-guard
MINIO_SECURE=false
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=3600

# ── Multimodal model ────────────────────────────────────────────────────────
MULTIMODAL_MODEL_DIR=~/.cache/bangla_fact_guard/multimodal_model
MULTIMODAL_DEVICE=cpu
MULTIMODAL_LOAD_ON_STARTUP=true
MULTIMODAL_MODEL_VERSION=banglabert_efficientnetb4_v1
MULTIMODAL_TEXT_SIM_THRESHOLD=0.92
MULTIMODAL_IMAGE_SIM_THRESHOLD=0.85
MULTIMODAL_COMBINED_SIM_THRESHOLD=0.90
MULTIMODAL_DEDUP_CANDIDATE_LIMIT=100

# ── Email (empty host = OTPs are logged instead of sent) ────────────────────
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@banglafactguard.local
EMAIL_FROM_NAME=BanglaFactGuard
EMAIL_OTP_LENGTH=6
EMAIL_OTP_TTL_MINUTES=10
EMAIL_WEBSITE_URL=http://localhost:4200

# ── Background jobs ─────────────────────────────────────────────────────────
JOBS_ENABLED=true
JOBS_MAX_CONCURRENT=2
JOBS_PHOTOCARD_MAX_CONCURRENT=4
JOBS_POLL_INTERVAL_SECONDS=5
JOBS_STALE_AFTER_SECONDS=120
JOBS_HEARTBEAT_INTERVAL_SECONDS=30

# ── Source-correspondence / search-adequacy thresholds ──────────────────────
THRESHOLD_CORR_HEADLINE_SIM_ALONE=0.85
THRESHOLD_CORR_HEADLINE_SIM_STRONG=0.72
THRESHOLD_CORR_HEADLINE_SIM_PLAUSIBLE=0.55
THRESHOLD_SEARCH_MIN_SUCCESSFUL_CALLS=2
THRESHOLD_SEARCH_MIN_SUCCESS_RATIO=0.5
