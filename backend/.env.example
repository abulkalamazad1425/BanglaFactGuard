# BanglaFactGuard — Environment Configuration
# ============================================
# Copy this file to `.env` and fill in all required values.
# Never commit `.env` to version control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=BanglaFactGuard
APP_VERSION=0.1.0
ENVIRONMENT=development           # development | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1

SECRET_KEY=CHANGE_ME_USE_STRONG_RANDOM_SECRET_IN_PRODUCTION

LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                   # json | console  (use console for local dev)

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bangla_fact_guard
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO_SQL=false

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=                   # Leave blank if no auth

# Cache TTLs (seconds) — override only if needed
REDIS_TTL_CLAIM_RESULT=86400
REDIS_TTL_SEARCH_RESULT=21600
REDIS_TTL_ARTICLE_CONTENT=43200
REDIS_TTL_EMBEDDING=172800
REDIS_TTL_NLI_OUTPUT=172800
REDIS_TTL_SOURCE_LOOKUP=604800

# ---------------------------------------------------------------------------
# Search APIs
# ---------------------------------------------------------------------------
SEARCH_TOP_K_CANDIDATES=5

# ---------------------------------------------------------------------------
# ML Models
# ---------------------------------------------------------------------------
ML_EMBEDDING_MODEL_NAME=paraphrase-multilingual-mpnet-base-v2
ML_NLI_MODEL_NAME=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
ML_NER_MODEL_NAME=arafatfahim/BanglaTag
ML_DEVICE=cpu                     # cpu | cuda | cuda:0
ML_USE_FP16=false
ML_EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# Gemini: the ONLY photo-card reader. From the original image it reads the
# headline, identifies the outlet among the active verified sources (and their
# aliases) and reads the printed date. Requests are made in batches: at most
# 3 per batch, 3 batches, a 10 s pause after a failed batch - at most 9 in
# total. Without a key photo cards cannot be processed (there is no OCR
# fallback). Headline Alteration and body similarity use local models only.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_ATTEMPTS_PER_BATCH=3
GEMINI_BATCHES=3
GEMINI_BATCH_PAUSE_SECONDS=10
GEMINI_RETRY_BASE_DELAY_SECONDS=1.0
# Photo-card jobs run in their own worker lane (never delay text jobs)
JOBS_PHOTOCARD_MAX_CONCURRENT=4

# ---------------------------------------------------------------------------
# MinIO Object Storage
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=bangla-fact-guard
MINIO_SECURE=false
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=3600

# ---------------------------------------------------------------------------
# Multimodal Model (BanglaBERT + EfficientNet-B4)
# ---------------------------------------------------------------------------
# Path to directory containing:
#   img_backbone.pt   — EfficientNetBackbone state dict
#   text_backbone.pt  — BanglaBERTBackbone state dict
#   classifier.pt     — MultiFusionFake state dict
#   tokenizer/        — Saved HuggingFace tokenizer directory
# Download these from the Google Drive training folder.
MULTIMODAL_MODEL_DIR=~/.cache/bangla_fact_guard/multimodal_model
MULTIMODAL_DEVICE=cpu                   # cpu | cuda | cuda:0
MULTIMODAL_LOAD_ON_STARTUP=true
MULTIMODAL_MODEL_VERSION=banglabert_efficientnetb4_v1

# Duplicate detection thresholds (all three must pass for a cache hit)
# Raise thresholds for stricter dedup; lower for more cache hits
MULTIMODAL_TEXT_SIM_THRESHOLD=0.92
MULTIMODAL_IMAGE_SIM_THRESHOLD=0.85
MULTIMODAL_COMBINED_SIM_THRESHOLD=0.90
MULTIMODAL_DEDUP_CANDIDATE_LIMIT=100

# ---------------------------------------------------------------------------
# Email (password-reset OTP delivery)
# ---------------------------------------------------------------------------
# Leave EMAIL_SMTP_HOST empty to disable real email sending — the OTP is
# logged to the backend console instead, which is enough for local/dev use.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=zaav yeox lqrn rvaz
EMAIL_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@banglafactguard.local
EMAIL_FROM_NAME=BanglaFactGuard
EMAIL_OTP_LENGTH=6
EMAIL_OTP_TTL_MINUTES=10



# ---------------------------------------------------------------------------
# Background verification jobs (text + photo-card) — durable DB-backed queue
# drained by an in-process worker. Jobs accepted before a restart, or left
# RUNNING by a crashed process, are re-claimed once their heartbeat is stale.
# ---------------------------------------------------------------------------
JOBS_ENABLED=true
JOBS_MAX_CONCURRENT=2                 # bounded: the pipeline has CPU-bound stretches
JOBS_POLL_INTERVAL_SECONDS=5
JOBS_STALE_AFTER_SECONDS=120          # restart-recovery latency
JOBS_HEARTBEAT_INTERVAL_SECONDS=30

# ---------------------------------------------------------------------------
# Result freshness (enforced in Redis AND in the database fallback)
# ---------------------------------------------------------------------------
REDIS_TTL_CLAIM_RESULT=86400          # complete results
REDIS_TTL_NOT_FOUND_RESULT=3600       # Source NOT_FOUND is shorter-lived

# ---------------------------------------------------------------------------
# Source-correspondence / search-adequacy thresholds (heuristics — NOT
# validated on labelled Bangla data). Headline Alteration constants are
# documented in app/features/verification/analysis/headline_comparison.py.
# ---------------------------------------------------------------------------
THRESHOLD_CORR_HEADLINE_SIM_ALONE=0.85
THRESHOLD_CORR_HEADLINE_SIM_STRONG=0.72
THRESHOLD_CORR_HEADLINE_SIM_PLAUSIBLE=0.55
THRESHOLD_SEARCH_MIN_SUCCESSFUL_CALLS=2
THRESHOLD_SEARCH_MIN_SUCCESS_RATIO=0.5

# Absolute website URL used in final-result email links.
EMAIL_WEBSITE_URL=http://localhost:4200
